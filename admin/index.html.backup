<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard — Smart KART</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        /* ══ RESET & BASE ══════════════════════════════════════════ */
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --sidebar-w: 240px;
            --topbar-h: 60px;
            --sidebar-bg: #1a1a2e;
            --sidebar-hover: rgba(255, 255, 255, .06);
            --sidebar-active: #7c3aed;
            --primary: #22c55e;
            --primary-d: #16a34a;
            --accent: #7c3aed;
            --accent-light: #ede9fe;
            --bg: #f0f2f8;
            --bg-card: #ffffff;
            --text: #1e293b;
            --text-muted: #64748b;
            --text-light: #94a3b8;
            --border: #e2e8f0;
            --shadow: 0 2px 12px rgba(0, 0, 0, .08);
            --shadow-md: 0 6px 24px rgba(0, 0, 0, .12);
            --r: 12px;
            --r-sm: 8px;
            --t: all .2s ease;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            font-size: 14px;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            cursor: pointer;
            border: none;
            background: none;
            font-family: inherit;
        }

        /* ══ SIDEBAR ═══════════════════════════════════════════════ */
        .sidebar {
            width: var(--sidebar-w);
            background: var(--sidebar-bg);
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            z-index: 200;
            transition: transform .3s ease;
            overflow: hidden;
        }

        .sidebar-logo {
            height: var(--topbar-h);
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 20px;
            border-bottom: 1px solid rgba(255, 255, 255, .07);
            flex-shrink: 0;
        }

        .sidebar-logo-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 16px;
        }

        .sidebar-logo-text {
            font-size: 17px;
            font-weight: 800;
            color: #fff;
        }

        .sidebar-logo-text span {
            color: var(--primary);
        }

        .sidebar-nav {
            flex: 1;
            overflow-y: auto;
            padding: 12px 0;
        }

        .sidebar-nav::-webkit-scrollbar {
            width: 3px;
        }

        .sidebar-nav::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, .1);
            border-radius: 3px;
        }

        .nav-section-title {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: #475569;
            padding: 16px 20px 6px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: #94a3b8;
            font-size: 13px;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: var(--t);
            cursor: pointer;
        }

        .nav-item i {
            width: 18px;
            font-size: 14px;
            text-align: center;
        }

        .nav-item:hover {
            background: var(--sidebar-hover);
            color: #e2e8f0;
        }

        .nav-item.active {
            background: rgba(124, 58, 237, .15);
            border-left-color: var(--accent);
            color: #fff;
        }

        .nav-item.active i {
            color: var(--accent);
        }

        .nav-badge {
            margin-left: auto;
            font-size: 10px;
            font-weight: 700;
            background: var(--accent);
            color: #fff;
            padding: 2px 7px;
            border-radius: 99px;
        }

        .nav-badge.green {
            background: var(--primary);
        }

        .sidebar-footer {
            padding: 16px 20px;
            border-top: 1px solid rgba(255, 255, 255, .07);
            flex-shrink: 0;
        }

        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            border-radius: var(--r-sm);
            background: rgba(255, 255, 255, .05);
        }

        .sidebar-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--accent);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
            flex-shrink: 0;
        }

        .sidebar-user-info {
            min-width: 0;
        }

        .sidebar-user-name {
            font-size: 13px;
            font-weight: 600;
            color: #e2e8f0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sidebar-user-role {
            font-size: 11px;
            color: #64748b;
        }

        /* ══ TOPBAR ════════════════════════════════════════════════ */
        .topbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-w);
            right: 0;
            height: var(--topbar-h);
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 24px;
            z-index: 100;
            box-shadow: var(--shadow);
        }

        .topbar-search {
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--bg);
            border: 1.5px solid var(--border);
            border-radius: 99px;
            padding: 7px 16px;
            flex: 1;
            max-width: 320px;
        }

        .topbar-search i {
            color: var(--text-muted);
            font-size: 13px;
        }

        .topbar-search input {
            border: none;
            background: transparent;
            font-size: 13px;
            color: var(--text);
            outline: none;
            width: 100%;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-left: auto;
        }

        .topbar-datetime {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            margin-right: 8px;
        }

        .topbar-date {
            font-size: 11px;
            color: var(--text-muted);
        }

        .topbar-time {
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
        }

        .icon-btn {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            font-size: 15px;
            background: var(--bg);
            border: 1.5px solid var(--border);
            transition: var(--t);
            position: relative;
        }

        .icon-btn:hover {
            background: var(--border);
            color: var(--text);
        }

        .icon-btn .badge-dot {
            position: absolute;
            top: 4px;
            right: 4px;
            width: 8px;
            height: 8px;
            background: #ef4444;
            border-radius: 50%;
            border: 2px solid var(--bg-card);
        }

        .topbar-user {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 5px 12px 5px 5px;
            background: var(--bg);
            border: 1.5px solid var(--border);
            border-radius: 99px;
            cursor: pointer;
            transition: var(--t);
        }

        .topbar-user:hover {
            border-color: var(--accent);
        }

        .topbar-user-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: var(--accent);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 12px;
        }

        .topbar-user-name {
            font-size: 13px;
            font-weight: 600;
        }

        .topbar-hamburger {
            display: none;
            width: 36px;
            height: 36px;
            align-items: center;
            justify-content: center;
            border-radius: var(--r-sm);
            background: var(--bg);
            font-size: 18px;
            color: var(--text-muted);
            border: 1.5px solid var(--border);
        }

        /* ══ MAIN CONTENT ══════════════════════════════════════════ */
        .main {
            margin-left: var(--sidebar-w);
            padding-top: var(--topbar-h);
            min-height: 100vh;
        }

        .content {
            padding: 24px;
        }

        /* ══ PAGE HEADER ═══════════════════════════════════════════ */
        .page-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .page-header-left h1 {
            font-size: 22px;
            font-weight: 800;
        }

        .page-header-left p {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .page-header-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .date-range-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 99px;
            background: var(--accent);
            color: #fff;
            font-size: 12px;
            font-weight: 600;
            border: none;
            cursor: pointer;
        }

        .create-btn {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 18px;
            border-radius: 99px;
            background: var(--primary);
            color: #fff;
            font-size: 12px;
            font-weight: 700;
        }

        .create-btn:hover {
            background: var(--primary-d);
        }

        /* ══ GRID SYSTEM ═══════════════════════════════════════════ */
        .grid {
            display: grid;
            gap: 20px;
        }

        .grid-4 {
            grid-template-columns: repeat(4, 1fr);
        }

        .grid-3 {
            grid-template-columns: repeat(3, 1fr);
        }

        .grid-2 {
            grid-template-columns: repeat(2, 1fr);
        }

        .grid-3-1 {
            grid-template-columns: 3fr 1fr;
        }

        .grid-2-1 {
            grid-template-columns: 2fr 1fr;
        }

        .grid-1-2 {
            grid-template-columns: 1fr 2fr;
        }

        .col-span-2 {
            grid-column: span 2;
        }

        .col-span-3 {
            grid-column: span 3;
        }

        /* ══ CARD ══════════════════════════════════════════════════ */
        .card {
            background: var(--bg-card);
            border-radius: var(--r);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .card-body {
            padding: 20px;
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px 0;
        }

        .card-title {
            font-size: 14px;
            font-weight: 700;
        }

        .card-subtitle {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        /* ══ KPI CARDS ═════════════════════════════════════════════ */
        .kpi {
            background: var(--bg-card);
            border-radius: var(--r);
            box-shadow: var(--shadow);
            padding: 18px 20px;
            border-left: 4px solid var(--kc, #22c55e);
            display: flex;
            align-items: center;
            gap: 16px;
            transition: transform .2s, box-shadow .2s;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
        }

        .kpi:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .kpi-icon-wrap {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: color-mix(in srgb, var(--kc, #22c55e) 12%, transparent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: var(--kc, #22c55e);
            flex-shrink: 0;
        }

        .kpi-body {
            flex: 1;
            min-width: 0;
        }

        .kpi-value {
            font-size: 22px;
            font-weight: 800;
            line-height: 1;
        }

        .kpi-label {
            font-size: 11px;
            color: var(--text-muted);
            font-weight: 500;
            margin-top: 3px;
        }

        .kpi-trend {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 11px;
            font-weight: 700;
            margin-top: 6px;
        }

        .kpi-trend.up {
            color: #22c55e;
        }

        .kpi-trend.down {
            color: #ef4444;
        }

        .kpi-trend.warn {
            color: #f59e0b;
        }

        /* ══ WELCOME CARD ══════════════════════════════════════════ */
        .welcome-card {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            border-radius: var(--r);
            padding: 22px;
            color: #fff;
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-md);
        }

        .welcome-card::before {
            content: '';
            position: absolute;
            right: -30px;
            top: -30px;
            width: 150px;
            height: 150px;
            background: rgba(255, 255, 255, .04);
            border-radius: 50%;
        }

        .welcome-card::after {
            content: '';
            position: absolute;
            right: 40px;
            bottom: -50px;
            width: 100px;
            height: 100px;
            background: rgba(124, 58, 237, .15);
            border-radius: 50%;
        }

        .welcome-hello {
            font-size: 11px;
            font-weight: 500;
            color: #94a3b8;
            margin-bottom: 4px;
        }

        .welcome-name {
            font-size: 18px;
            font-weight: 800;
        }

        .welcome-orders {
            font-size: 40px;
            font-weight: 800;
            color: #fff;
            margin: 16px 0 4px;
            line-height: 1;
        }

        .welcome-orders-label {
            font-size: 11px;
            color: #64748b;
        }

        .welcome-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid rgba(255, 255, 255, .08);
            font-size: 12px;
            color: #94a3b8;
        }

        .welcome-row i {
            color: var(--accent);
        }

        /* ══ STAT METRIC ═══════════════════════════════════════════ */
        .metric-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid var(--border);
            font-size: 13px;
        }

        .metric-row:last-child {
            border-bottom: none;
        }

        .metric-label {
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .metric-badge {
            padding: 2px 8px;
            border-radius: 99px;
            font-size: 10px;
            font-weight: 700;
        }

        .metric-badge.green {
            background: #dcfce7;
            color: #166534;
        }

        .metric-badge.yellow {
            background: #fef9c3;
            color: #854d0e;
        }

        .metric-badge.red {
            background: #fee2e2;
            color: #991b1b;
        }

        .metric-badge.purple {
            background: #ede9fe;
            color: #5b21b6;
        }

        /* ══ CHART AREA ════════════════════════════════════════════ */
        .chart-wrap {
            position: relative;
        }

        /* ══ RECENT ORDERS TABLE ═══════════════════════════════════ */
        .orders-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        .orders-table th {
            background: #f8fafc;
            padding: 10px 16px;
            text-align: left;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border);
        }

        .orders-table td {
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        .orders-table tr:last-child td {
            border-bottom: none;
        }

        .orders-table tr:hover td {
            background: #f8fafc;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            border-radius: 99px;
            font-size: 11px;
            font-weight: 700;
        }

        .status-pill.delivered {
            background: #dcfce7;
            color: #166534;
        }

        .status-pill.processing {
            background: #dbeafe;
            color: #1e40af;
        }

        .status-pill.pending {
            background: #fef9c3;
            color: #854d0e;
        }

        .status-pill.shipped {
            background: #ede9fe;
            color: #5b21b6;
        }

        .status-pill.cancelled {
            background: #fee2e2;
            color: #991b1b;
        }

        /* ══ DONUT LEGEND ══════════════════════════════════════════ */
        .d-legend {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 12px;
        }

        .d-legend-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
        }

        .d-dot {
            display: inline-block;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            margin-right: 6px;
        }

        /* ══ ALERT CARD ════════════════════════════════════════════ */
        .alert-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid var(--border);
        }

        .alert-item:last-child {
            border-bottom: none;
        }

        .alert-thumb {
            width: 38px;
            height: 38px;
            border-radius: var(--r-sm);
            object-fit: cover;
            background: var(--bg);
            flex-shrink: 0;
        }

        .alert-name {
            font-size: 13px;
            font-weight: 600;
        }

        .alert-meta {
            font-size: 11px;
            color: var(--text-muted);
        }

        .alert-stock {
            margin-left: auto;
        }

        /* ══ RESPONSIVE ════════════════════════════════════════════ */
        @media (max-width: 1200px) {
            .grid-4 {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 1024px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .main {
                margin-left: 0;
            }

            .topbar {
                left: 0;
            }

            .topbar-hamburger {
                display: flex;
            }

            .grid-3-1 {
                grid-template-columns: 1fr;
            }

            .grid-2-1 {
                grid-template-columns: 1fr;
            }

            .grid-1-2 {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .content {
                padding: 16px;
            }

            .grid-4 {
                grid-template-columns: 1fr 1fr;
            }

            .grid-3 {
                grid-template-columns: 1fr 1fr;
            }

            .grid-2 {
                grid-template-columns: 1fr;
            }

            .topbar-search {
                display: none;
            }

            .topbar-datetime {
                display: none;
            }

            .col-span-2 {
                grid-column: span 1;
            }
        }

        @media (max-width: 480px) {
            .grid-4 {
                grid-template-columns: 1fr 1fr;
            }

            .kpi {
                padding: 14px;
            }

            .kpi-value {
                font-size: 18px;
            }

            .kpi-icon-wrap {
                width: 40px;
                height: 40px;
                font-size: 17px;
            }
        }

        /* ══ SIDEBAR OVERLAY ═══════════════════════════════════════ */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, .45);
            z-index: 199;
        }

        .sidebar-overlay.open {
            display: block;
        }

        /* ══ SKELETON ══════════════════════════════════════════════ */
        @keyframes shimmer {
            0% {
                background-position: -600px 0;
            }

            100% {
                background-position: 600px 0;
            }
        }

        .skel {
            background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
            background-size: 1200px 100%;
            animation: shimmer 1.4s linear infinite;
            border-radius: 6px;
        }

        /* ══ TOAST ═════════════════════════════════════════════════ */
        #toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .toast {
            background: #fff;
            border-radius: 10px;
            padding: 12px 18px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, .15);
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            font-weight: 500;
            opacity: 0;
            transform: translateX(20px);
            transition: all .3s;
            max-width: 320px;
        }

        .toast.show {
            opacity: 1;
            transform: translateX(0);
        }

        .toast-success {
            border-left: 3px solid #22c55e;
        }

        .toast-error {
            border-left: 3px solid #ef4444;
        }

        .toast-info {
            border-left: 3px solid #3b82f6;
        }

        .toast-warning {
            border-left: 3px solid #f59e0b;
        }
    </style>
</head>

<body>

    <!-- ── SIDEBAR ──────────────────────────────────────────────── -->
    <div class="sidebar-overlay" id="sidebar-overlay" onclick="closeSidebar()"></div>
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-logo">
            <div class="sidebar-logo-icon"><i class="fas fa-shopping-basket"></i></div>
            <div class="sidebar-logo-text">Smart<span>KART</span></div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section-title">Main</div>
            <a href="index.html" class="nav-item active">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>
            <a href="analytics.html" class="nav-item">
                <i class="fas fa-chart-bar"></i> Analytics
            </a>

            <div class="nav-section-title">Catalogue</div>
            <a href="products.html" class="nav-item">
                <i class="fas fa-box"></i> Products
                <span class="nav-badge green" id="sb-products">—</span>
            </a>
            <a href="orders.html" class="nav-item">
                <i class="fas fa-shopping-bag"></i> Orders
                <span class="nav-badge" id="sb-orders">—</span>
            </a>

            <div class="nav-section-title">People</div>
            <a href="users.html" class="nav-item">
                <i class="fas fa-users"></i> Customers
                <span class="nav-badge" id="sb-customers">—</span>
            </a>
            <a href="coupons.html" class="nav-item">
                <i class="fas fa-tag"></i> Coupons
            </a>

            <div class="nav-section-title">System</div>
            <a href="../index.html" class="nav-item" target="_blank">
                <i class="fas fa-store"></i> View Store
            </a>
            <a href="#" class="nav-item" onclick="logout()">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="sidebar-avatar" id="sb-avatar">A</div>
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name" id="sb-name">Admin</div>
                    <div class="sidebar-user-role">Super Admin</div>
                </div>
            </div>
        </div>
    </aside>

    <!-- ── TOPBAR ───────────────────────────────────────────────── -->
    <header class="topbar">
        <button class="topbar-hamburger icon-btn" id="hamburger-btn" onclick="toggleSidebar()">
            <i class="fas fa-bars"></i>
        </button>

        <div class="topbar-search">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="Search products, orders…" id="top-search" />
        </div>

        <div class="topbar-right">
            <div class="topbar-datetime">
                <div class="topbar-date" id="tb-date">—</div>
                <div class="topbar-time" id="tb-time">—:—</div>
            </div>

            <button class="icon-btn" title="Notifications" onclick="window.location='orders.html'">
                <i class="fas fa-bell"></i>
                <span class="badge-dot" id="notif-dot" style="display:none"></span>
            </button>
            <button class="icon-btn" title="Low Stock" onclick="window.location='products.html'">
                <i class="fas fa-exclamation-triangle"></i>
                <span class="badge-dot" id="stock-dot" style="display:none"></span>
            </button>
            <button class="icon-btn" id="theme-toggle" title="Toggle theme">
                <i class="fas fa-moon"></i>
            </button>

            <div class="topbar-user" onclick="window.location='users.html'">
                <div class="topbar-user-avatar" id="tb-avatar">A</div>
                <span class="topbar-user-name" id="tb-name">Admin</span>
                <i class="fas fa-chevron-down" style="font-size:10px;color:var(--text-muted)"></i>
            </div>
        </div>
    </header>

    <!-- ── MAIN ─────────────────────────────────────────────────── -->
    <main class="main">
        <div class="content">

            <!-- Page header -->
            <div class="page-header">
                <div class="page-header-left">
                    <h1>Dashboard</h1>
                    <p id="greeting-sub">Welcome back! Here's what's happening with your store.</p>
                </div>
                <div class="page-header-right">
                    <div class="date-range-btn">
                        <i class="fas fa-calendar-alt"></i>
                        <span id="hdr-date">Today</span>
                    </div>
                    <a href="products.html" class="create-btn">
                        <i class="fas fa-plus"></i> Add Product
                    </a>
                </div>
            </div>

            <!-- ── ROW 1: KPI CARDS ── -->
            <div class="grid grid-4" style="margin-bottom:20px" id="kpi-row">
                <div class="skel" style="height:100px;border-radius:12px"></div>
                <div class="skel" style="height:100px;border-radius:12px"></div>
                <div class="skel" style="height:100px;border-radius:12px"></div>
                <div class="skel" style="height:100px;border-radius:12px"></div>
            </div>

            <!-- ── ROW 2: Welcome + Stats + Donut Chart ── -->
            <div class="grid" style="grid-template-columns:1fr 1.4fr 1.4fr;margin-bottom:20px;gap:20px" id="row2">
                <!-- Welcome -->
                <div class="welcome-card" id="welcome-card">
                    <div class="welcome-hello">Welcome back,</div>
                    <div class="welcome-name" id="wc-name">Admin</div>
                    <div class="welcome-orders" id="wc-orders">—</div>
                    <div class="welcome-orders-label">Total Orders</div>
                    <div class="welcome-row">
                        <i class="fas fa-box"></i>
                        <span id="wc-products">— products available</span>
                    </div>
                </div>

                <!-- Revenue & Quick Stats -->
                <div class="card">
                    <div class="card-header">
                        <div>
                            <div class="card-title">Revenue Summary</div>
                            <div class="card-subtitle">From delivered orders</div>
                        </div>
                        <i class="fas fa-rupee-sign" style="color:var(--primary);font-size:16px"></i>
                    </div>
                    <div class="card-body" style="padding-top:14px">
                        <div style="font-size:28px;font-weight:800;color:var(--text);margin-bottom:4px" id="rev-big">—
                        </div>
                        <div class="kpi-trend up" id="rev-trend">
                            <i class="fas fa-arrow-trend-up"></i> From all paid orders
                        </div>
                        <hr style="border:none;border-top:1px solid var(--border);margin:14px 0">
                        <div class="metric-row">
                            <span class="metric-label"><i class="fas fa-clock" style="color:#f59e0b"></i> Pending</span>
                            <span style="font-weight:700" id="m-pending">—</span>
                        </div>
                        <div class="metric-row">
                            <span class="metric-label"><i class="fas fa-check-circle" style="color:#22c55e"></i>
                                Delivered</span>
                            <span style="font-weight:700;color:#22c55e" id="m-delivered">—</span>
                        </div>
                        <div class="metric-row">
                            <span class="metric-label"><i class="fas fa-times-circle" style="color:#ef4444"></i>
                                Cancelled</span>
                            <span style="font-weight:700;color:#ef4444" id="m-cancelled">—</span>
                        </div>
                    </div>
                </div>

                <!-- Donut Chart -->
                <div class="card">
                    <div class="card-header">
                        <div>
                            <div class="card-title">Orders by Status</div>
                            <div class="card-subtitle">Distribution overview</div>
                        </div>
                    </div>
                    <div class="card-body" style="padding-top:10px">
                        <div style="position:relative;max-height:160px;display:flex;justify-content:center">
                            <canvas id="donut-chart" style="max-height:160px"></canvas>
                            <div
                                style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;pointer-events:none">
                                <div style="font-size:20px;font-weight:800" id="donut-num">—</div>
                                <div style="font-size:10px;color:var(--text-muted)">orders</div>
                            </div>
                        </div>
                        <div class="d-legend" id="donut-legend" style="margin-top:10px"></div>
                    </div>
                </div>
            </div>

            <!-- ── ROW 3: Revenue Bar Chart + Low Stock ── -->
            <div class="grid" style="grid-template-columns:2fr 1fr;margin-bottom:20px;gap:20px" id="row3">
                <!-- Bar/Area Chart -->
                <div class="card">
                    <div class="card-header">
                        <div>
                            <div class="card-title">Order Status Overview</div>
                            <div class="card-subtitle">Breakdown of your recent orders</div>
                        </div>
                        <a href="analytics.html" style="font-size:12px;color:var(--accent);font-weight:600">View
                            Analytics →</a>
                    </div>
                    <div class="card-body" style="padding-top:10px">
                        <canvas id="bar-chart" height="180"></canvas>
                        <div style="display:flex;gap:20px;margin-top:12px;flex-wrap:wrap" id="bar-legend"></div>
                    </div>
                </div>

                <!-- Low stock alerts -->
                <div class="card">
                    <div class="card-header">
                        <div>
                            <div class="card-title">⚠️ Stock Alerts</div>
                            <div class="card-subtitle">Products needing restock</div>
                        </div>
                        <a href="products.html" style="font-size:12px;color:var(--accent);font-weight:600">Manage</a>
                    </div>
                    <div class="card-body" style="padding-top:10px" id="low-stock-card">
                        <div class="skel" style="height:44px;margin-bottom:8px"></div>
                        <div class="skel" style="height:44px;margin-bottom:8px"></div>
                        <div class="skel" style="height:44px"></div>
                    </div>
                </div>
            </div>

            <!-- ── ROW 4: Recent Orders Table ── -->
            <div class="card">
                <div class="card-header" style="padding-bottom:12px">
                    <div>
                        <div class="card-title">Recent Orders</div>
                        <div class="card-subtitle">Latest customer orders</div>
                    </div>
                    <a href="orders.html" class="create-btn"
                        style="background:var(--accent);font-size:11px;padding:6px 14px">
                        View All Orders
                    </a>
                </div>
                <div style="overflow-x:auto">
                    <table class="orders-table" id="orders-table">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody id="orders-tbody">
                            <tr>
                                <td colspan="5" style="text-align:center;padding:30px;color:var(--text-muted)">
                                    <i class="fas fa-spinner fa-spin"></i> Loading…
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div><!-- /content -->
    </main>

    <div id="toast-container"></div>

    <script src="../api-service.js"></script>
    <script>
        /* ══ STATUS COLORS ══════════════════════════════════════ */
        const SC = {
            Delivered: '#22c55e',
            Processing: '#3b82f6',
            Pending: '#f59e0b',
            Shipped: '#8b5cf6',
            Cancelled: '#ef4444',
        };
        const SP = {
            Delivered: 'delivered', Processing: 'processing',
            Pending: 'pending', Shipped: 'shipped', Cancelled: 'cancelled',
        };

        /* ══ INIT ═══════════════════════════════════════════════ */
        document.addEventListener('DOMContentLoaded', () => {
            if (!Auth.isAdmin()) { window.location.href = '../login.html?next=admin/index.html'; return; }
            const user = Auth.getUser();
            const name = user?.customer_name?.split(' ')[0] || 'Admin';
            const init = name.charAt(0).toUpperCase();

            // Topbar + sidebar name
            ['tb-name', 'sb-name', 'wc-name'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.textContent = name;
            });
            ['tb-avatar', 'sb-avatar'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.textContent = init;
            });

            // Greeting
            const h = new Date().getHours();
            const g = h < 12 ? '🌅 Good morning' : h < 17 ? '☀️ Good afternoon' : '🌙 Good evening';
            document.getElementById('greeting-sub').textContent = `${g}, ${name}! Here's your store overview.`;

            // Clock + date
            function tick() {
                const now = new Date();
                document.getElementById('tb-time').textContent = now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });
                document.getElementById('tb-date').textContent = now.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' });
                document.getElementById('hdr-date').textContent = now.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
            }
            tick(); setInterval(tick, 1000);

            loadDashboard();
        });

        /* ══ SIDEBAR TOGGLE ═════════════════════════════════════ */
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('sidebar-overlay').classList.toggle('open');
        }
        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebar-overlay').classList.remove('open');
        }

        /* ══ LOAD DATA ══════════════════════════════════════════ */
        async function loadDashboard() {
            try {
                const [dashRes, prodRes] = await Promise.all([adminAPI.dashboard(), adminAPI.products()]);
                const d = dashRes.data;
                const prods = prodRes.data || [];

                renderKPIs(d, prods);
                renderWelcome(d, prods);
                renderRevenue(d);
                renderDonut(d);
                renderBarChart(d);
                renderLowStock(prods);
                renderOrdersTable(d.recent_orders || []);

                // Sidebar badges
                document.getElementById('sb-products').textContent = d.total_products;
                document.getElementById('sb-orders').textContent = d.total_orders;
                document.getElementById('sb-customers').textContent = d.total_customers;

                // Alert dots
                if (d.pending_orders > 0) document.getElementById('notif-dot').style.display = 'block';
                if (d.low_stock_alerts > 0) document.getElementById('stock-dot').style.display = 'block';
            } catch (e) { showToast('Failed to load dashboard: ' + e.message, 'error'); }
        }

        /* ══ KPI CARDS ══════════════════════════════════════════ */
        function renderKPIs(d, prods) {
            const outOfStock = prods.filter(p => p.product_quantity === 0).length;
            const defs = [
                {
                    label: 'Total Revenue', val: '₹' + parseFloat(d.total_revenue || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 }),
                    icon: 'fa-rupee-sign', color: '#22c55e',
                    trend: 'up', trendTxt: 'From delivered orders', link: 'analytics.html'
                },
                {
                    label: 'Total Orders', val: d.total_orders,
                    icon: 'fa-shopping-bag', color: '#3b82f6',
                    trend: d.pending_orders > 0 ? 'warn' : 'up', trendTxt: d.pending_orders + ' pending', link: 'orders.html'
                },
                {
                    label: 'Customers', val: d.total_customers,
                    icon: 'fa-users', color: '#8b5cf6',
                    trend: 'up', trendTxt: 'Registered accounts', link: 'users.html'
                },
                {
                    label: 'Products', val: d.total_products,
                    icon: 'fa-box', color: '#f59e0b',
                    trend: d.low_stock_alerts > 0 ? 'warn' : 'up',
                    trendTxt: d.low_stock_alerts > 0 ? d.low_stock_alerts + ' low stock' : 'All stocked', link: 'products.html'
                },
            ];
            document.getElementById('kpi-row').innerHTML = defs.map(k => `
    <a href="${k.link}" class="kpi" style="--kc:${k.color}">
        <div class="kpi-icon-wrap"><i class="fas ${k.icon}"></i></div>
        <div class="kpi-body">
            <div class="kpi-value">${k.val}</div>
            <div class="kpi-label">${k.label}</div>
            <div class="kpi-trend ${k.trend}">
                <i class="fas ${k.trend === 'up' ? 'fa-arrow-trend-up' : k.trend === 'warn' ? 'fa-exclamation-triangle' : 'fa-arrow-trend-down'}"></i>
                ${k.trendTxt}
            </div>
        </div>
    </a>`).join('');
        }

        /* ══ WELCOME CARD ═══════════════════════════════════════ */
        function renderWelcome(d, prods) {
            document.getElementById('wc-orders').textContent = d.total_orders;
            document.getElementById('wc-products').textContent = d.total_products + ' products available';
        }

        /* ══ REVENUE SUMMARY ════════════════════════════════════ */
        function renderRevenue(d) {
            document.getElementById('rev-big').textContent = '₹' + parseFloat(d.total_revenue || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 });
            const orders = d.recent_orders || [];
            const counts = {};
            orders.forEach(o => counts[o.order_status] = (counts[o.order_status] || 0) + 1);
            document.getElementById('m-pending').textContent = d.pending_orders;
            document.getElementById('m-delivered').textContent = counts['Delivered'] || 0;
            document.getElementById('m-cancelled').textContent = counts['Cancelled'] || 0;
        }

        /* ══ DONUT CHART ════════════════════════════════════════ */
        function renderDonut(d) {
            const orders = d.recent_orders || [];
            const counts = {};
            orders.forEach(o => counts[o.order_status] = (counts[o.order_status] || 0) + 1);
            const labels = Object.keys(counts), vals = Object.values(counts);
            const total = vals.reduce((a, b) => a + b, 0) || 1;
            document.getElementById('donut-num').textContent = d.total_orders;

            new Chart(document.getElementById('donut-chart'), {
                type: 'doughnut',
                data: {
                    labels,
                    datasets: [{ data: vals, backgroundColor: labels.map(l => SC[l] || '#94a3b8'), borderWidth: 0, borderRadius: 3, hoverOffset: 5 }]
                },
                options: {
                    cutout: '72%', plugins: {
                        legend: { display: false }, tooltip: {
                            callbacks: { label: c => ' ' + c.label + ': ' + c.raw + ' (' + Math.round(c.raw / total * 100) + '%)' }
                        }
                    }
                }
            });

            document.getElementById('donut-legend').innerHTML = labels.map((l, i) => `
    <div class="d-legend-item">
        <span><span class="d-dot" style="background:${SC[l] || '#94a3b8'}"></span>${l}</span>
        <strong>${vals[i]}</strong>
    </div>`).join('');
        }

        /* ══ BAR CHART ══════════════════════════════════════════ */
        function renderBarChart(d) {
            const orders = d.recent_orders || [];
            const statuses = ['Pending', 'Processing', 'Shipped', 'Delivered', 'Cancelled'];
            const counts = {};
            orders.forEach(o => counts[o.order_status] = (counts[o.order_status] || 0) + 1);
            const vals = statuses.map(s => counts[s] || 0);

            new Chart(document.getElementById('bar-chart'), {
                type: 'bar',
                data: {
                    labels: statuses,
                    datasets: [{
                        label: 'Orders',
                        data: vals,
                        backgroundColor: statuses.map(s => SC[s] || '#94a3b8'),
                        borderRadius: 6,
                        borderSkipped: false,
                    }]
                },
                options: {
                    plugins: {
                        legend: { display: false }, tooltip: {
                            callbacks: { label: c => ` ${c.raw} orders` }
                        }
                    },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1, font: { size: 11 } }, grid: { color: '#f1f5f9' } },
                        x: { ticks: { font: { size: 11 } }, grid: { display: false } }
                    }
                }
            });

            document.getElementById('bar-legend').innerHTML = statuses.map((s, i) => `
    <div style="display:flex;align-items:center;gap:5px;font-size:11px;font-weight:600">
        <span style="width:10px;height:10px;border-radius:50%;background:${SC[s]};display:inline-block"></span>
        ${s}: <strong>${vals[i]}</strong>
    </div>`).join('');
        }

        /* ══ LOW STOCK ══════════════════════════════════════════ */
        function renderLowStock(prods) {
            const low = prods.filter(p => p.product_quantity <= 10 && p.product_status === 'available')
                .sort((a, b) => a.product_quantity - b.product_quantity).slice(0, 6);
            document.getElementById('low-stock-card').innerHTML = low.length
                ? low.map(p => `
        <div class="alert-item">
            <img class="alert-thumb"
                 src="${p.product_image || 'https://images.unsplash.com/photo-1542838132-92c53300491e?w=80&q=60'}"
                 onerror="this.src='https://images.unsplash.com/photo-1542838132-92c53300491e?w=80&q=60'"
                 alt="${p.product_name}"/>
            <div>
                <div class="alert-name" style="font-size:12px">${p.product_name}</div>
                <div class="alert-meta">${p.category_name || 'Uncategorised'}</div>
            </div>
            <div class="alert-stock">
                <span class="status-pill ${p.product_quantity === 0 ? 'cancelled' : 'pending'}" style="font-size:10px">
                    ${p.product_quantity === 0 ? 'Out of Stock' : p.product_quantity + ' left'}
                </span>
            </div>
        </div>`).join('')
                : `<div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px">
            <i class="fas fa-check-circle" style="color:#22c55e;font-size:24px;display:block;margin-bottom:8px"></i>
            All products are well stocked!
           </div>`;
        }

        /* ══ ORDERS TABLE ═══════════════════════════════════════ */
        function renderOrdersTable(orders) {
            const fmt = d => d ? new Date(d).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
            document.getElementById('orders-tbody').innerHTML = orders.slice(0, 8).map(o => `
    <tr>
        <td style="font-weight:700;color:var(--accent)">#${o.id}</td>
        <td>
            <div style="font-weight:600">${o.customer_name || '—'}</div>
        </td>
        <td style="font-weight:800">₹${parseFloat(o.order_total_amount || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 })}</td>
        <td><span class="status-pill ${SP[o.order_status] || ''}">${o.order_status}</span></td>
        <td style="color:var(--text-muted);font-size:12px">${fmt(o.created_date)}</td>
    </tr>`).join('') || `
    <tr><td colspan="5" style="text-align:center;padding:30px;color:var(--text-muted)">
        <i class="fas fa-shopping-cart" style="font-size:24px;display:block;margin-bottom:8px;color:var(--border)"></i>
        No orders yet
    </td></tr>`;
        }

        /* ══ TOP SEARCH ═════════════════════════════════════════ */
        document.getElementById('top-search').addEventListener('keydown', e => {
            if (e.key === 'Enter') {
                const q = e.target.value.trim();
                if (q) window.location.href = '../products.html?search=' + encodeURIComponent(q);
            }
        });

        /* ══ THEME TOGGLE ═══════════════════════════════════════ */
        // Handled by api-service.js global theme toggle
    </script>
</body>

</html>